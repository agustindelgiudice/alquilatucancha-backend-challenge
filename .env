# Intervalo en segundos entre eventos (definido en el código)
EVENT_INTERVAL_SECONDS=10

# Cantidad máxima de solicitudes permitidas por minuto
REQUESTS_PER_MINUTE=60

# URL donde se publican los eventos generados por la API mock
EVENT_PUBLISHER_URL=http://mock:3000/events

# Puerto donde corre la API mock
PORT=4000

# Host de Redis (puede cambiar en entornos como producción)
REDIS_HOST=redis

# Puerto de Redis (por defecto es 6379)
REDIS_PORT=6379
